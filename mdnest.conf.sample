# mdnest configuration
# Copy this file to mdnest.conf and edit to match your setup.
# Run ./mdnest-server rebuild to generate docker-compose.yml and start.

# Auth — change these before first run
MDNEST_USER=admin
MDNEST_PASSWORD=changeme
MDNEST_JWT_SECRET=changeme

# Server alias — a short name for THIS server that shows up in CLI paths
# and copy-path URIs from the web UI (e.g. mdnest://@work/namespace/path).
# Strongly recommended. When set, `mdnest login <url> <token>` auto-picks
# this as the CLI alias. Leave it unset only if you want CLI users to
# always pass @alias explicitly on login.
SERVER_ALIAS=mdnest

# Frontend origin (for CORS)
FRONTEND_ORIGIN=http://localhost:3236

# Ports
BACKEND_PORT=8286
FRONTEND_PORT=3236
# Bind address: 127.0.0.1 = localhost only (default)
# Only set to 0.0.0.0 if you understand the security implications.
# Comma-separated values bind multiple host IPs — useful when you want
# localhost AND a private overlay address (Tailscale, ZeroTier, VPN) but
# NOT 0.0.0.0. Each IP must be valid for an interface on this host.
# Example: BIND_ADDRESS=127.0.0.1,100.73.118.115
# BIND_ADDRESS=127.0.0.1

# Git sync (optional — auto-enabled when keys are in git-sync/keys/)
# Sync is off by default. Your notes stay local unless you set it up.
GIT_AUTHOR_NAME=Your Name
GIT_AUTHOR_EMAIL=you@example.com
# GIT_SYNC_INTERVAL=600          # Seconds between sync cycles (default 10 minutes)

# Search tuning (optional — defaults work for most setups)
# Increase these if you have a large repository (5,000+ notes).
# SEARCH_MAX_RESULTS=30          # Max results per query
# SEARCH_MAX_FILE_SIZE=1048576   # Skip files larger than this (bytes, default 1MB)
# SEARCH_WORKERS=8               # Parallel file readers
# SEARCH_CACHE_TTL=30            # File list cache lifetime (seconds)

# Auth mode: "single" (default) or "multi"
# Single mode: one user, file-based auth (current behavior, no database needed)
# Multi mode: multiple users with roles & permissions, requires PostgreSQL
# AUTH_MODE=single

# PostgreSQL (required only when AUTH_MODE=multi)
# When multi mode is enabled, setup.sh auto-adds a Postgres container to docker-compose.yml.
# If you prefer an external Postgres, set POSTGRES_HOST to its address.
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432
# POSTGRES_DB=mdnest
# POSTGRES_USER=mdnest
# POSTGRES_PASSWORD=changeme

# SSH key for git pull (optional)
# Path to an SSH private key on the host. Used by the sync button to pull
# from git remotes. Must be unencrypted (no passphrase).
# If your key has a passphrase, generate a dedicated deploy key:
#   ssh-keygen -t ed25519 -f ~/.ssh/mdnest-deploy -N ""
# Then add the .pub key to your GitHub repo's deploy keys.
# SSH_KEY_PATH=/home/you/.ssh/mdnest-deploy

# Live collaboration (optional, requires AUTH_MODE=multi)
# Enables real-time cursor presence and conflict detection via WebSocket.
# Also required for the inline comments feature (/api/comments).
# ENABLE_LIVE_COLLAB=false

# Task board (optional, works in both single and multi mode)
# Projects the GitHub-flavoured `- [ ]` checkboxes already in your notes into a
# per-namespace kanban board. No new datastore: a task is a line in a note, and
# the column layout lives in the namespace's .mdnest/board.json sidecar (same
# convention as .mdnest/comments, and hidden from the file tree).
# Off by default — when it is off the /api/tasks and /api/board routes are not
# registered and the frontend never loads the board's UI chunk.
# ENABLE_TASK_BOARD=false

# Marp slide rendering (optional, works in both single and multi mode)
# A note whose frontmatter declares `marp: true` renders as a slide deck in the
# Preview pane, so the note you draft an idea in is also the deck you present
# from. The Live editor is unchanged, and notes without `marp: true` render
# exactly as before.
# Off by default — when it is off the capability is not advertised and the
# frontend never loads the Marp engine chunk.
# ENABLE_MARP=false

# Centralized Marp themes (optional, requires ENABLE_MARP=true). A separate
# opt-in that adds a shared theme catalog decks reference by name (theme:
# <name>) plus a superadmin editor. Themes live in a reserved, hidden
# namespace (auto-created, git-versioned locally, never mirrored to a remote).
# Off by default.
# ENABLE_MARP_THEMES=false

# Excalidraw drawings (optional). `.excalidraw.md` files open in a drawing
# editor instead of the text editor; the markdown file stays the source of
# truth (the scene is a fenced JSON block and text is mirrored for search).
# Off by default — when off those files open as plain text and the frontend
# never loads the (large) Excalidraw chunk.
# ENABLE_EXCALIDRAW=false

# ==========================================================================
# Federated identity via Firebase (optional, requires AUTH_MODE=multi)
# ==========================================================================
# Turn identity into a shared service across multiple mdnest servers. Users
# sign in with Google; TOTP enrolls ONCE in Firestore and works on every
# server that points at the same Firebase project. Each server still decides
# which emails are authorized and at what role.
#
# Step-by-step setup (create project, download keys, configure OAuth):
#     docs/firebase-setup.md
#
# Quick reference:
#   1. Create a Firebase project at https://console.firebase.google.com
#   2. Enable Google sign-in (Authentication → Sign-in method).
#   3. Enable Firestore in production mode.
#   4. Download a service account JSON (Project settings → Service accounts).
#   5. Copy the web SDK config JSON (Project settings → Your apps → Web).
#   6. Fill in the four fields below.
#   7. Add your email to ADMIN_EMAILS so you get admin role on first sign-in.
#
# USER_PROVIDER=firebase
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_SERVICE_ACCOUNT=/home/you/mdnest/firebase-service-account.json
# FIREBASE_WEB_CONFIG=/home/you/mdnest/firebase-web-config.json
#
# Emails promoted to admin on every startup (comma-separated, case-insensitive).
# Removals are NOT auto-demoted — demote explicitly via the admin UI.
# ADMIN_EMAILS=you@example.com,teammate@example.com

# ==========================================================================
# Corporate SSO via generic OIDC (optional, requires AUTH_MODE=multi)
# ==========================================================================
# Alternative to the Firebase block above. Users sign in through your
# corporate IdP (Google Workspace, Okta, Microsoft Entra, Keycloak, Auth0 —
# anything that speaks OIDC discovery). Email is the primary identity key —
# the user must ALREADY exist in mdnest's users table (invited by an admin).
# No auto-provisioning. The IdP owns MFA, so local 2FA is skipped entirely.
#
# Step-by-step setup (create OAuth client, register redirect URI, fill in
# these values): docs/sso-setup.md
#
# USER_PROVIDER=sso
# SSO_ISSUER_URL=https://accounts.google.com        # Google's OIDC issuer
# SSO_CLIENT_ID=<from-devops>
# SSO_CLIENT_SECRET=<from-devops>
#
# Optional — restrict sign-in to specific corporate domains:
# SSO_ALLOWED_DOMAINS=yourorg.com
#
# Optional — override the button label shown on the sign-in page:
# SSO_PROVIDER_LABEL=Google
#
# Optional — only set if your redirect URI isn't FRONTEND_ORIGIN/api/auth/sso/callback:
# SSO_REDIRECT_URL=https://notes.example.com/api/auth/sso/callback
#
# Optional (opt-in) — auto-create a least-privilege collaborator on first SSO
# login for an unknown but IdP-authenticated email, instead of rejecting it, so
# users need no superadmin invite. Off by default. Enable only when the IdP
# gates who may obtain a token (pair with SSO_ALLOWED_DOMAINS).
# SSO_AUTOPROVISION_USERS=true

# ==========================================================================
# INSECURE: dev-only login backdoor (for local SSO testing)
# ==========================================================================
# When INSECURE_DEV_LOGIN=true, an unauthenticated POST /api/auth/dev-login
# endpoint is registered that mints a 30-day session JWT for ANY existing
# user, by email — completely bypassing the IdP. The default sign-in page
# is unchanged (still strict SSO); the backdoor is only accessible by
# manually opening http://<host>/?login=dev. While enabled, every
# authenticated page renders a sticky red warning bar.
#
# This is for local development only. NEVER set true on a non-localhost
# deployment — anyone who can reach the backend can impersonate any user.
# Leave commented (defaults to false).
# INSECURE_DEV_LOGIN=true

# ==========================================================================
# Grant path depth limit
# ==========================================================================
# How deep into a namespace tree an admin can scope a grant. "/" is depth 0
# and is always allowed; "/foo" is depth 1; "/foo/bar" is depth 2; etc.
# New grants beyond this depth are rejected at the API. Existing rows are
# grandfathered (no migration). PathPicker in the admin UI also hides
# folders past this depth.
#
# Default: 3 (covers top folder + two layers, which fits most org
# structures). Set to 0 for no limit.
# GRANT_MAX_DEPTH=3

# ==========================================================================
# Docker compose project name
# ==========================================================================
# Pin the project name so this install can run side-by-side with another
# mdnest install in a different directory. By default docker compose
# names the project after the current directory, so two checkouts in
# folders both named "mdnest" (e.g. one for development, one tracking
# release) end up sharing containers and clobbering each other on every
# rebuild. Setting this to a unique value per install removes the conflict.
# Leave commented for a single install — the default works fine.
# COMPOSE_PROJECT_NAME=mdnest-dev

# ==========================================================================
# Update availability check
# ==========================================================================
# By default the backend polls https://api.github.com/repos/mahsanamin/mdnest
# once every 24 hours and surfaces the latest release on /api/config so the
# frontend can hint when a newer mdnest is available (with the release notes
# inline). One outbound HTTPS request per server per day; failures are
# logged at info level and ignored.
#
# Set to true on air-gapped / privacy-sensitive installs to disable the
# check entirely. UPDATE_CHECK_REPO can override the upstream repo for forks.
# DISABLE_UPDATE_CHECK=true
# UPDATE_CHECK_REPO=mahsanamin/mdnest

# HTTPS with Caddy (optional)
# Set CADDY_DOMAIN to enable automatic HTTPS via Let's Encrypt.
# Caddy runs as a container, terminates TLS, and proxies to the frontend.
# Ports 80 and 443 are exposed; backend/frontend ports become internal only.
# The domain must have a DNS A record pointing to this server's public IP.
# CADDY_DOMAIN=notes.example.com

# MCP server for AI agents (optional)
# Runs the bundled Model Context Protocol server as a streamable-HTTP service
# so AI agents (Claude, Cursor, scripts) can read/write notes over the network.
# Disabled by default and gated behind a compose profile — existing installs
# are unaffected. See docs/mcp.md for the full guide.
# ENABLE_MCP=true
#
# service mode (default): the server uses ONE mdnest API token for every call.
# Create it in Settings > API Tokens after the first boot, then set it here and
# run ./mdnest-server rebuild. Only expose the endpoint on a trusted network.
# MCP_TOKEN=mdnest_your_token_here
#
# Host port for the /mcp endpoint (default 3000).
# MCP_HTTP_PORT=3000
#
# oauth mode: each client brings its own user's JWT via corporate SSO, so every
# action is attributed to the real user. Requires all three variables below.
# MCP_AUTH_MODE=oauth
# MCP_PUBLIC_URL=https://mcp.notes.example.com
# MCP_OAUTH_SECRET=change-me-to-a-long-random-string
# MCP_SSO_AUTHORIZE_URL=https://notes.example.com/api/sso/authorize
# Origins allowed to receive an OAuth authorization code, comma-separated.
# Loopback (127.0.0.1 / localhost) is ALWAYS allowed — that covers native MCP
# clients and needs no configuration. Only set this if a hosted client on a
# real domain must complete the flow. Leave it empty otherwise: an
# authorization code carries a live mdnest token, so anything not listed here
# is refused.
# MCP_ALLOWED_REDIRECT_ORIGINS=https://agent.example.com

# Namespace mounts
# Each line maps a namespace name to a host directory.
# Format: MOUNT_<name>=<host_path>
# These directories will be mounted into the container and appear as namespaces.
# Example:
# MOUNT_personal=/home/you/notes/personal
# MOUNT_work=/home/you/notes/work
#
# Optional: a disposable namespace for the CLI smoke-test harness
# (tests/cli-smoke-test.sh). It creates and deletes throwaway notes under a
# unique prefixed folder, so keep it separate from real notes. After adding
# this line run `./mdnest-server reload` to mount it, then run the harness.
# MOUNT_testing_workspace=/home/you/notes/testing_workspace
