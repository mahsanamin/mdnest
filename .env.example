MDNEST_USER=ahsan
MDNEST_PASSWORD=changeme
MDNEST_JWT_SECRET=changeme
NOTES_DIR=./notes
FRONTEND_ORIGIN=http://localhost
GIT_REMOTE=git@github.com:youruser/my-brain.git
GIT_AUTHOR_NAME=Your Name
GIT_AUTHOR_EMAIL=you@example.com

# --- git-native HA (multi-replica; leave unset for a single-box install) ---
# Role of this process: single (default) | app (stateless replica) | writer.
# MDNEST_ROLE=single
# Redis coherence tier (required for app/writer; enables the working set).
# REDIS_URL=redis://localhost:6379/0
# REDIS_WORKINGSET_MAX_BYTES=1048576
# Durable git backend (writer/single); app replicas read a git-sync'd clone.
# STORAGE_BACKEND=git
# GIT_COMMIT_INTERVAL=10s
# Writer leader-lock TTL (bounds failover after a writer crash).
# MDNEST_WRITER_LOCK_TTL=15s
# Per-namespace remote mirror: one git repository per workspace, over HTTPS.
# GIT_REMOTE_URL=https://gitlab.example.com/mdnest-workspaces
# GIT_REMOTE_USERNAME=oauth2
# GIT_REMOTE_BRANCH=main
# Two-way sync cadence: how often to pull remote changes even with no local
# edits (Go duration; 0 disables the periodic pull). On each sync mdnest fetches
# the remote, merges it in (conflicts are committed with markers to resolve in
# the editor), pushes local changes, and reflects pulled notes to every replica.
# GIT_SYNC_INTERVAL=1m
# Personal Access Token: prefer a file (a mounted Secret) over the raw value.
# GIT_TOKEN_FILE=/etc/mdnest/git/token
# GIT_TOKEN=
# Per-workspace git remotes (multi mode): a namespace can override the coarse
# GIT_REMOTE_URL default with its own repository, over HTTPS (PAT) or SSH (deploy
# key), configured at runtime in the UI (Admin → Git Workspaces / Settings → Git
# remote) and stored encrypted in Postgres.
# Secret used to seal those credentials at rest (AES-256-GCM). Falls back to
# MDNEST_JWT_SECRET when unset; set it to rotate git creds independently.
# MDNEST_ENCRYPTION_KEY=
# Optional allow-list of git hosts accepted for per-workspace remotes
# (comma-separated; empty = any, relying on the writer's egress NetworkPolicy).
# GIT_REMOTE_ALLOWED_HOSTS=gitlab.forterro.com,github.com
