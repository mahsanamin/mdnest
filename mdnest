#!/bin/bash
set -e

MDNEST_CLI_VERSION="4.3.3-dev"
CONFIG_DIR="${HOME}/.config/mdnest"
SERVERS_DIR="${CONFIG_DIR}/servers"
DEFAULT_FILE="${CONFIG_DIR}/default"

# Legacy single-server config (backward compat)
LEGACY_CONFIG="${CONFIG_DIR}/config"

# ─── Server config helpers ──────────────────────────────────────────────────

get_server_file() {
  echo "${SERVERS_DIR}/${1}"
}

load_server() {
  local alias="$1"
  if [ -n "$alias" ] && [ -f "$(get_server_file "$alias")" ]; then
    MDNEST_URL=$(grep '^url=' "$(get_server_file "$alias")" 2>/dev/null | cut -d= -f2-) || MDNEST_URL=""
    MDNEST_TOKEN=$(grep '^token=' "$(get_server_file "$alias")" 2>/dev/null | cut -d= -f2-) || MDNEST_TOKEN=""
    CURRENT_ALIAS="$alias"
    return 0
  fi
  return 1
}

load_default() {
  if [ -f "$DEFAULT_FILE" ]; then
    local def
    def=$(cat "$DEFAULT_FILE") || def=""
    if load_server "$def"; then return 0; fi
  fi
  if [ -d "$SERVERS_DIR" ]; then
    local first
    first=$(ls "$SERVERS_DIR" 2>/dev/null | head -1) || first=""
    if [ -n "$first" ] && load_server "$first"; then return 0; fi
  fi
  if [ -f "$LEGACY_CONFIG" ]; then
    MDNEST_URL=$(grep '^url=' "$LEGACY_CONFIG" 2>/dev/null | cut -d= -f2-) || MDNEST_URL=""
    MDNEST_TOKEN=$(grep '^token=' "$LEGACY_CONFIG" 2>/dev/null | cut -d= -f2-) || MDNEST_TOKEN=""
    CURRENT_ALIAS="default"
    return 0
  fi
  return 1
}

# Deprecation nudge. "default" as an alias is no longer created at login
# time (we refuse it and pull from /api/config instead), but existing
# installs may still have one. Let the user know how to fix it, once per
# invocation so scripts don't get spammed.
warn_if_default_alias() {
  if [ "$CURRENT_ALIAS" = "default" ] && [ -z "$MDNEST_DEFAULT_WARNED" ]; then
    export MDNEST_DEFAULT_WARNED=1
    cat >&2 <<'WARN'
Notice: you're using the deprecated @default alias. Rename it so the
server has a real name in your CLI:
  mdnest rename @default @<new-name>
The server's own SERVER_ALIAS (in mdnest.conf) will be picked up
automatically on next login if set.
WARN
  fi
}

# Is this string something we can actually talk to? Anything without an
# http(s) scheme isn't, and the overwhelmingly common cause is an alias
# written without its leading '@' — which shifts every positional along, so
# the URL lands in the token slot and the token is dropped entirely. Catch it
# here rather than reporting a conclusion about a server we never contacted.
valid_url() {
  case "$1" in
    http://?*|https://?*) return 0 ;;
    *) return 1 ;;
  esac
}

# GETs the target server's /api/config. Stdout is the raw body; the exit
# status is curl's, so the caller can tell "we never reached it" apart from
# "we reached it and it told us nothing" — two different problems that need
# two different fixes, and conflating them is what made a DNS failure read as
# a complaint about the server's mdnest.conf.
fetch_server_config() {
  curl -s --connect-timeout 5 --max-time 8 "${1}/api/config" 2>/dev/null
}

# Turns a curl exit code into a reason a human can act on.
curl_reason() {
  case "$1" in
    6)     echo "the host name could not be resolved (DNS)" ;;
    7)     echo "the connection was refused" ;;
    28)    echo "the connection timed out" ;;
    35|60) echo "the TLS handshake failed" ;;
    *)     echo "curl exited $1" ;;
  esac
}

# True when $1 is strictly newer than $2. Pure bash: no python3, no jq, and no
# `sort -V` (busybox sort has no -V, and this must work on the fresh-machine
# tier like everything else here).
#
# Pre-release aware in the one way that matters: a release outranks a
# pre-release of the same core, so 4.3.2 > 4.3.2-dev and a -dev build never
# nags about the release it is a candidate for. Mirrors isVersionNewer() in
# App.jsx, which does the same job for the in-app banner.
version_gt() {
  # First line only. A caller that hands us a multi-line value (a sloppy JSON
  # grep, say) must not be able to fabricate an upgrade: "4.3.1\n4.3.1" would
  # otherwise compare its third field as "14" and beat 4.3.2.
  local a="${1%%$'\n'*}" b="${2%%$'\n'*}" a_pre="" b_pre="" i x y
  a="${a#v}"; b="${b#v}"
  case "$a" in *-*) a_pre="${a#*-}"; a="${a%%-*}" ;; esac
  case "$b" in *-*) b_pre="${b#*-}"; b="${b%%-*}" ;; esac
  for i in 1 2 3; do
    x="${a%%.*}"; y="${b%%.*}"
    # Drop anything non-numeric so a stray suffix can't make [ -gt ] error out.
    x="${x//[!0-9]/}"; y="${y//[!0-9]/}"
    [ -n "$x" ] || x=0
    [ -n "$y" ] || y=0
    if [ "$x" -gt "$y" ]; then return 0; fi
    if [ "$x" -lt "$y" ]; then return 1; fi
    case "$a" in *.*) a="${a#*.}" ;; *) a=0 ;; esac
    case "$b" in *.*) b="${b#*.}" ;; *) b=0 ;; esac
  done
  if [ -z "$a_pre" ] && [ -n "$b_pre" ]; then return 0; fi
  return 1
}

# One line telling the user their CLI is behind, and exactly how to fix it.
# Printed where someone is already looking at versions (`mdnest servers`,
# `mdnest whoami`, `mdnest login`) rather than on every command — the CLI has
# no update cache, and a nag on every read would be its own bug.
#
# The reference point is the SERVER's version, because the CLI and the server
# ship from the same repo at the same number: if the box you are talking to is
# newer than the script talking to it, the script is stale. This deliberately
# does not reach out to GitHub — no extra network call, no new failure mode.
cli_update_notice() {
  local server_ver="$1" who="$2"
  version_gt "$server_ver" "$MDNEST_CLI_VERSION" || return 0
  echo ""
  echo "  Your mdnest CLI is v${MDNEST_CLI_VERSION}; ${who} is running v${server_ver}."
  echo "  Update it with:  mdnest update"
  return 0
}

# Pulls SERVER_ALIAS (if any) out of an /api/config body already fetched by
# fetch_server_config. Stdout is the alias, or empty if the server has none.
parse_server_alias() {
  printf '%s' "$1" | grep -o '"serverAlias":"[^"]*"' | cut -d'"' -f4
  return 0
}

require_server() {
  if [ -z "$MDNEST_URL" ] || [ -z "$MDNEST_TOKEN" ]; then
    echo "Not logged in. Run: mdnest login @alias <url> <token>" >&2
    exit 1
  fi
}

# ─── Path parser ────────────────────────────────────────────────────────────
# Parses: @alias/namespace/path/to/file.md
# Or:     namespace/path/to/file.md (uses default server)
# Or:     @alias (just server)
# Or:     @alias/namespace (server + namespace)

parse_path() {
  local input="$1"
  PARSED_ALIAS=""
  PARSED_NS=""
  PARSED_PATH=""

  # Accept copy-path URIs from the web UI (e.g. mdnest://@alias/ns/19%20Jun.md):
  # strip the scheme and percent-decode the namespace + path so the copied,
  # escaped path is usable verbatim. Only decode for the mdnest:// form so raw
  # CLI paths that legitimately contain '%' are left untouched.
  local _decode=0
  if [[ "$input" == mdnest://* ]]; then
    input="${input#mdnest://}"
    _decode=1
  fi

  if [[ "$input" == @* ]]; then
    local rest="${input#@}"
    PARSED_ALIAS="${rest%%/*}"
    if [[ "$rest" == */* ]]; then
      rest="${rest#*/}"
    else
      rest=""
    fi
    input="$rest"
  fi

  if [ -n "$PARSED_ALIAS" ]; then
    if ! load_server "$PARSED_ALIAS"; then
      echo "Unknown server: @${PARSED_ALIAS}. Run 'mdnest servers' to see configured servers." >&2
      exit 1
    fi
  elif [ -z "$MDNEST_URL" ]; then
    if ! load_default; then
      echo "Not logged in. Run: mdnest login @alias <url> <token>" >&2
      exit 1
    fi
  fi

  if [ -n "$input" ]; then
    PARSED_NS="${input%%/*}"
    if [[ "$input" == */* ]]; then
      PARSED_PATH="${input#*/}"
    fi
  fi

  if [ "$_decode" = "1" ]; then
    [ -n "$PARSED_NS" ] && PARSED_NS=$(urldecode "$PARSED_NS")
    [ -n "$PARSED_PATH" ] && PARSED_PATH=$(urldecode "$PARSED_PATH")
  fi
}

# ─── API helpers ────────────────────────────────────────────────────────────

api() {
  local method="$1" path="$2" body="$3"
  # --connect-timeout bounds a hanging/unreachable connection so a command
  # fails fast with a clear message instead of blocking forever (MDNEST_TIMEOUT
  # overrides for slow links). No --max-time: note bodies can be large and
  # legitimately slow to transfer; only the connect phase is capped.
  local args=(-s -w "\n%{http_code}" --connect-timeout "${MDNEST_TIMEOUT:-10}" -H "Authorization: Bearer $MDNEST_TOKEN")
  [ -n "$body" ] && args+=(-d "$body")
  local response curl_rc=0
  # Guard the assignment with `|| curl_rc=$?`. The CLI runs under `set -e`, and
  # a PLAIN assignment from a command substitution takes the substitution's exit
  # status — so an unguarded `response=$(curl ...)` kills the whole script the
  # moment curl can't connect, and every line below (including this error block)
  # is dead code. `mdnest read @unreachable/ns/x.md` printed NOTHING and exited
  # with curl's 28. Do NOT re-add a following `curl_rc=$?`: it would overwrite
  # the real curl code with the status of the now-successful assignment.
  response=$(curl "${args[@]}" -X "$method" "${MDNEST_URL}/api${path}") || curl_rc=$?
  if [ "$curl_rc" != "0" ]; then
    case "$curl_rc" in
      6)  echo "Error: can't resolve host for ${MDNEST_URL} (DNS)." >&2 ;;
      7)  echo "Error: connection refused by ${MDNEST_URL}." >&2 ;;
      28) echo "Error: timed out connecting to ${MDNEST_URL} (set MDNEST_TIMEOUT to raise the limit)." >&2 ;;
      *)  echo "Error: couldn't reach ${MDNEST_URL} (curl exit $curl_rc)." >&2 ;;
    esac
    return 1
  fi
  local http_code="${response##*$'\n'}"
  local resp_body="${response%$'\n'*}"

  if [ "$http_code" -ge 400 ] 2>/dev/null; then
    echo "Error ($http_code): $resp_body" >&2
    return 1
  fi
  echo "$resp_body"
}

# ─── Dependency-tolerant helpers ─────────────────────────────────────────────
# The CLI must work on a fresh machine that may not have python3 (or jq). These
# helpers prefer a real parser when present and fall back to pure-bash/awk so no
# command silently breaks just because python3 is missing.

have() { command -v "$1" >/dev/null 2>&1; }

# py — run a python3 snippet defensively. Every python3 call in this CLI goes
# through here, for two reasons:
#   -S  skip site initialisation. A broken entry in the user's site-packages
#       (a stale .pth left behind by e.g. matplotlib) makes python3 print a
#       traceback to stderr on EVERY start; without -S that noise lands in the
#       middle of mdnest's output and looks like an mdnest crash (issue #87).
#   -E  ignore PYTHON* env vars, so a stray PYTHONPATH/PYTHONWARNINGS can't
#       inject imports or warnings either.
# stderr is dropped and a non-zero exit is returned to the caller, because every
# call site has a pure-bash/awk fallback: a python3 that is present but broken
# must degrade to the fallback, not fail the command. Snippets here use only the
# standard library, which -S/-E do not affect.
py() {
  have python3 || return 127
  python3 -S -E "$@" 2>/dev/null
}

# Resolve this script's real path (following symlinks) WITHOUT depending on
# `readlink -f` (unsupported on macOS/BSD) or python3 — both of which are absent
# on a bare fresh machine, where the old fallback left the path empty and broke
# `mdnest update` / `mdnest docs`.
resolve_self() {
  local src="$1" dir link
  while [ -L "$src" ]; do
    dir="$(cd -P "$(dirname "$src")" 2>/dev/null && pwd)"
    link="$(readlink "$src")"
    case "$link" in
      /*) src="$link" ;;
      *)  src="$dir/$link" ;;
    esac
  done
  dir="$(cd -P "$(dirname "$src")" 2>/dev/null && pwd)"
  printf '%s/%s\n' "$dir" "$(basename "$src")"
}

# Warn ONCE if we have no JSON parser at all, so the degraded-but-working state
# is visible rather than mysterious. Fallbacks below still work without it.
_dep_warned=0
warn_no_parser() {
  [ "$_dep_warned" = "1" ] && return 0
  _dep_warned=1
  if ! have python3 && ! have jq; then
    echo "mdnest: note — neither python3 nor jq found; using a basic built-in parser." >&2
    echo "mdnest: for best results install python3 (macOS: 'xcode-select --install')." >&2
  fi
  return 0
}

urlencode() {
  local out
  if out=$(py -c "import urllib.parse, sys; print(urllib.parse.quote(sys.argv[1]))" "$1") \
     && { [ -n "$out" ] || [ -z "$1" ]; }; then
    printf '%s' "$out"
    return 0
  fi
  # Pure-bash percent-encode. Reserved set matches urllib.parse.quote's DEFAULT
  # (safe='/'), so '/' stays literal — urlencode is called on full note paths
  # like ns/dir/file.md and the server expects the slashes intact. Kept unencoded:
  # A-Z a-z 0-9 . ~ _ - and /. Multibyte UTF-8 is encoded byte-by-byte under the
  # C locale so each byte becomes its own %XX (matches the server's decoding).
  local s="$1" out="" i c
  local LC_ALL=C
  for (( i=0; i<${#s}; i++ )); do
    c="${s:i:1}"
    case "$c" in
      [a-zA-Z0-9.~_/-]) out+="$c" ;;
      *) out+=$(printf '%%%02X' "'$c") ;;
    esac
  done
  printf '%s' "$out"
}

urldecode() {
  local out
  if out=$(py -c "import urllib.parse, sys; print(urllib.parse.unquote(sys.argv[1]))" "$1") \
     && { [ -n "$out" ] || [ -z "$1" ]; }; then
    printf '%s' "$out"
    return 0
  fi
  # Turn '+' into space and %XX into the raw byte, then let printf %b emit the
  # bytes (works for UTF-8 sequences too: %E2%80%A6 -> \xE2\x80\xA6 -> bytes).
  local s="${1//+/ }"
  printf '%b' "${s//%/\\x}"
}

# json_top_string <field>  — reads JSON on stdin, prints the value of a
# TOP-LEVEL string field. Prefers python3, then jq; the bash fallback is
# brace-depth aware so it never returns a value from a nested object (e.g. it
# returns the top-level "version", not latestRelease.version — which is emitted
# FIRST in /api/config, so a naive grep|head would pick the wrong one).
json_top_string() {
  local field="$1" data out
  data=$(cat) || data=""
  # A python3 that can't parse the body (or can't start at all) returns non-zero
  # and we fall through to jq/awk, rather than reporting an empty field.
  if out=$(printf '%s' "$data" | py -c \
      "import sys,json; print(json.load(sys.stdin).get(sys.argv[1],''))" "$field"); then
    printf '%s\n' "$out"
    return 0
  fi
  if have jq; then
    # `return 0`, not a bare `return`: a bare one propagates jq's exit status,
    # and callers assign this into a plain variable, which under `set -e` would
    # abort the script instead of yielding an empty field.
    printf '%s' "$data" | jq -r --arg f "$field" '.[$f] // empty' 2>/dev/null
    return 0
  fi
  # Bash/awk fallback: scan for "field": at object depth 1 only. Accumulates all
  # input into `buf` and processes it in END so it works whether the JSON is on
  # one line or many, and portably across gawk / mawk / busybox awk (no reliance
  # on a null RS to slurp — busybox awk handles that differently).
  printf '%s' "$data" | awk -v want="$field" '
    { buf = buf $0 "\n" }
    END {
      n=length(buf); depth=0; instr=0; esc=0; key=""; capkey=0
      for (i=1;i<=n;i++) {
        c=substr(buf,i,1)
        if (esc) { if(capkey)key=key c; esc=0; continue }
        if (c=="\\") { if(capkey)key=key c; esc=1; continue }
        if (c=="\"") {
          if (instr) { instr=0; if(capkey){capkey=0} }
          else { instr=1; if(depth==1){capkey=1; key=""} }
          continue
        }
        if (instr) { if(capkey)key=key c; continue }
        if (c=="{"||c=="[") { depth++; continue }
        if (c=="}"||c=="]") { depth--; continue }
        if (c==":" && depth==1 && key==want) {
          j=i+1
          while (j<=n && substr(buf,j,1)!="\"") j++
          j++; val=""
          while (j<=n) { ch=substr(buf,j,1); if(ch=="\\"){val=val substr(buf,j,2); j+=2; continue}; if(ch=="\"")break; val=val ch; j++ }
          print val; exit
        }
      }
    }'
}

# ─── Output formatting ──────────────────────────────────────────────────────
# `mdnest list` used to dump the raw API JSON, which is unreadable for a
# namespace of any size (issue #87). The formatters below render it for humans;
# `--json` still returns the raw payload for scripts.
#
# Deliberately awk-only, no python3/jq tier: awk is on every machine mdnest
# supports, the output is then identical everywhere, and a broken python
# install can't garble a listing.

# Shared awk helpers, so both formatters decode JSON strings the same way.
_AWK_JSON_LIB='
function hex2dec(h,   i, c, d, v) {
  v = 0
  for (i = 1; i <= length(h); i++) {
    c = tolower(substr(h, i, 1))
    d = index("0123456789abcdef", c) - 1
    if (d < 0) return -1
    v = v * 16 + d
  }
  return v
}
# Decode a JSON string body (the bytes between the quotes) into plain text.
function unesc(s,   out, i, len, c, nx, v) {
  out = ""; len = length(s); i = 1
  while (i <= len) {
    c = substr(s, i, 1)
    if (c != "\\") { out = out c; i++; continue }
    nx = substr(s, i + 1, 1)
    if (nx == "u") {
      # Go escapes the HTML-unsafe ASCII characters (<, >, &) as \uXXXX. Decode
      # the printable ASCII range; leave anything else as the literal escape
      # rather than guessing at multi-byte sequences (Go emits those raw anyway).
      v = hex2dec(substr(s, i + 2, 4))
      if (v >= 32 && v < 127) { out = out sprintf("%c", v); i += 6; continue }
      out = out substr(s, i, 6); i += 6; continue
    }
    if (nx == "n") { out = out "\n"; i += 2; continue }
    if (nx == "t") { out = out "\t"; i += 2; continue }
    if (nx == "r") { i += 2; continue }
    out = out nx; i += 2   # \" \\ \/ and anything else: keep the character
  }
  return out
}
# Read the JSON string starting at buf[i] (i on the opening quote): sets JSTR to
# the decoded value and returns the index just past the closing quote.
function jstr(buf, i,   s, ch, len) {
  len = length(buf); s = ""; i++
  while (i <= len) {
    ch = substr(buf, i, 1)
    if (ch == "\\") { s = s substr(buf, i, 2); i += 2; continue }
    if (ch == "\"") { i++; break }
    s = s ch; i++
  }
  JSTR = unesc(s)
  return i
}
'

# format_namespaces <json>  — a JSON string array, one name per line.
format_namespaces() {
  printf '%s' "$1" | awk "$_AWK_JSON_LIB"'
    { buf = buf $0 }
    END {
      len = length(buf); i = 1; cnt = 0
      while (i <= len) {
        if (substr(buf, i, 1) == "\"") { i = jstr(buf, i); print JSTR; cnt++; continue }
        i++
      }
      if (cnt == 0) {
        print "No namespaces on this server — they come from MOUNT_ entries in mdnest.conf." > "/dev/stderr"
      }
    }'
}

# format_tree <json> <header> [scoped-path]  — render an /api/tree response as
# an indented tree under <header>. With a scoped path, only that node and its
# descendants are shown (and a missing path is an error, exit 3).
format_tree() {
  printf '%s' "$1" | MDN_HEADER="$2" MDN_WANT="${3:-}" awk "$_AWK_JSON_LIB"'
    BEGIN {
      header = ENVIRON["MDN_HEADER"]; want = ENVIRON["MDN_WANT"]
      sub(/^\/+/, "", want); sub(/\/+$/, "", want)
    }
    { buf = buf $0 }
    END {
      # Pass 1 — flatten the tree into pre-order arrays. The API emits each node
      # as {"name":..,"type":..,"path":..,"children":[..]}, so a node is complete
      # before its children appear and document order IS pre-order. Depth is the
      # number of open braces, which is all the nesting information we need.
      len = length(buf); i = 1; depth = 0; key = ""; cnt = 0; maxd = 0
      while (i <= len) {
        c = substr(buf, i, 1)
        if (c == "\"") {
          i = jstr(buf, i); s = JSTR
          j = i
          while (j <= len && substr(buf, j, 1) ~ /[ \t\r\n]/) j++
          if (substr(buf, j, 1) == ":") { key = s; i = j + 1; continue }
          # Values are recorded against the object that is currently open, and
          # back-filled if "type" (which creates the entry) came first.
          if (key == "name") { nm[depth] = s; if (at[depth]) nname[at[depth]] = s }
          else if (key == "path") { pth[depth] = s; if (at[depth]) npath[at[depth]] = s }
          else if (key == "type") {
            cnt++; nd[cnt] = depth; ntype[cnt] = s
            nname[cnt] = nm[depth]; npath[cnt] = pth[depth]; at[depth] = cnt
          }
          key = ""
          continue
        }
        if (c == "{") {
          depth++; if (depth > maxd) maxd = depth
          nm[depth] = ""; pth[depth] = ""; at[depth] = 0; i++; continue
        }
        if (c == "}") { depth--; i++; continue }
        i++
      }
      if (cnt == 0) { print "Error: could not read the namespace tree" > "/dev/stderr"; exit 4 }

      # Pass 2 — pick the slice to print: the whole tree, or one scoped subtree.
      base = nd[1]; ttype = ntype[1]; start = 2; endi = cnt
      if (want != "") {
        found = 0
        for (k = 1; k <= cnt; k++) {
          p = npath[k]; sub(/^\/+/, "", p); sub(/\/+$/, "", p)
          if (p == want) { found = k; break }
        }
        if (found == 0) { print "Error: path not found in namespace: " want > "/dev/stderr"; exit 3 }
        base = nd[found]; ttype = ntype[found]; start = found + 1; endi = cnt
        for (k = start; k <= cnt; k++) if (nd[k] <= base) { endi = k - 1; break }
        if (header == "") header = npath[found]
      }

      print header
      if (endi < start) {
        if (ttype == "folder") print "  (empty)"
        exit 0
      }

      # Pass 3 — a node is the last child of its parent when no later node shares
      # its depth before the depth drops. Walking backwards answers that at once:
      # seen[d] is reset for everything deeper each time the depth drops.
      for (k = endi; k >= start; k--) {
        d = nd[k]
        islast[k] = seen[d] ? 0 : 1
        seen[d] = 1
        for (e = d + 1; e <= maxd; e++) seen[e] = 0
      }

      folders = 0; files = 0
      for (k = start; k <= endi; k++) {
        lvl = nd[k] - base
        pre = ""
        for (a = 1; a < lvl; a++) pre = pre (anc[a] ? "    " : "│   ")
        pre = pre (islast[k] ? "└── " : "├── ")
        anc[lvl] = islast[k]
        if (ntype[k] == "folder") { print pre nname[k] "/"; folders++ }
        else                      { print pre nname[k];     files++ }
      }
      printf "\n%d %s, %d %s\n", folders, (folders == 1 ? "folder" : "folders"), \
                                 files,   (files   == 1 ? "file"   : "files")
    }'
}

# ─── Commands ───────────────────────────────────────────────────────────────

cmd_login() {
  local alias="" url="" tok="" alias_source=""

  if [[ "$1" == @* ]]; then
    alias="${1#@}"
    url="$2"
    tok="$3"
    alias_source="explicit"
  else
    url="$1"
    tok="$2"
    alias_source="autodetect"
  fi

  if [ -z "$url" ] || [ -z "$tok" ]; then
    cat <<'USAGE'
Usage:
  mdnest login @alias <url> <token>   Pick the alias yourself.
  mdnest login <url> <token>          Use the server's own SERVER_ALIAS
                                      (server must set it in mdnest.conf).

The @alias is any short name (e.g. @work, @home, @staging). It shows up
in your paths (mdnest://@alias/ns/file.md) and in copy-path URIs from
the web UI.

Examples:
  mdnest login @work     https://work.example.com  mdnest_abc123
  mdnest login @personal https://home.example.com  mdnest_def456
  mdnest login           https://myserver.com      mdnest_xyz789
USAGE
    exit 1
  fi

  # Validate the URL before we do anything with it: before contacting a
  # server, before drawing conclusions about its config, and above all before
  # writing it to disk. Saving a non-URL used to succeed with only a warning,
  # and on a fresh machine it also became the default server — so every later
  # command aimed at garbage.
  if ! valid_url "$url"; then
    if [ "$alias_source" = "autodetect" ] && valid_url "$tok"; then
      # `mdnest login myserver https://... mdnest_token` — the alias is missing
      # its '@', so print the same command with that one character fixed.
      # Placeholders here are literal words, never <angle brackets>: the shell
      # reads '<name>' as a redirection, so a hint containing one can't be
      # pasted back into the terminal that just printed it.
      cat >&2 <<ERR
Error: '${url}' is not a URL — an alias needs a leading '@'.

Run:
  mdnest login @${url} ${tok} ${3:-mdnest_yourtoken}
ERR
    else
      cat >&2 <<ERR
Error: '${url}' is not a URL — it must start with http:// or https://.

Run:
  mdnest login @myserver https://notes.example.com mdnest_yourtoken
ERR
    fi
    exit 1
  fi

  # Only now that the positionals line up: reject a stray extra one instead of
  # ignoring it. A silent drop saves credentials for something the user didn't
  # quite ask for. (Checked after the URL, so a missing '@' still gets the
  # specific hint above rather than this generic one.)
  if { [ "$alias_source" = "explicit" ] && [ -n "$4" ]; } ||
     { [ "$alias_source" = "autodetect" ] && [ -n "$3" ]; }; then
    cat >&2 <<ERR
Error: too many arguments. login takes an optional @alias, a URL, and a token:

  mdnest login @myserver https://notes.example.com mdnest_yourtoken
ERR
    exit 1
  fi

  url="${url%/}"

  # Resolve alias when it wasn't given explicitly: ask the server.
  if [ "$alias_source" = "autodetect" ]; then
    local cfg="" cfg_rc=0
    cfg=$(fetch_server_config "$url") && cfg_rc=0 || cfg_rc=$?
    if [ "$cfg_rc" != "0" ] || [ -z "$cfg" ]; then
      local reason
      if [ "$cfg_rc" = "0" ]; then
        reason="it returned an empty response"
      else
        reason=$(curl_reason "$cfg_rc") || reason=""
      fi
      cat >&2 <<ERR
Error: couldn't reach ${url} to ask what it calls itself — ${reason}.

Nothing about that server's own config can be read until it answers, so
either get it reachable from here, or name it yourself:

  mdnest login @myserver ${url} ${tok}
ERR
      exit 1
    fi
    alias=$(parse_server_alias "$cfg") || alias=""
    if [ -z "$alias" ]; then
      cat >&2 <<ERR
Error: ${url} answered, but has no SERVER_ALIAS set, so the CLI can't pick
a name for it automatically.

Fix either end:
  1. Name it here and now — nothing to change on the server:
       mdnest login @myserver ${url} ${tok}
  2. Or set SERVER_ALIAS in the server's mdnest.conf and reload it:
       SERVER_ALIAS=myserver
       ./mdnest-server reload

(We used to silently name it @default, but that hid which server was
which — so it's blocked now.)
ERR
      exit 1
    fi
  fi

  # Refuse the literal "default" alias — it carries the same confusion
  # we're trying to kill.
  if [ "$alias" = "default" ]; then
    cat >&2 <<'ERR'
Error: '@default' is not a valid alias — pick a meaningful name like
@work, @home, @staging. The name appears in copy-path URIs from the
web UI, so it should identify the server.
ERR
    exit 1
  fi

  mkdir -p "$SERVERS_DIR"

  # Overwriting an existing alias is fine (same name, same server,
  # just rotating the token). Warn only if the URL changes underneath.
  if [ -f "$(get_server_file "$alias")" ]; then
    local existing_url
    existing_url=$(grep '^url=' "$(get_server_file "$alias")" 2>/dev/null | cut -d= -f2-) || existing_url=""
    if [ -n "$existing_url" ] && [ "$existing_url" != "$url" ]; then
      echo "Warning: @${alias} currently points at ${existing_url}; replacing with ${url}."
    fi
  fi

  cat > "$(get_server_file "$alias")" <<EOF
url=${url}
token=${tok}
EOF
  chmod 600 "$(get_server_file "$alias")"

  # First login on a fresh machine → become the default.
  if [ ! -f "$DEFAULT_FILE" ]; then
    echo "$alias" > "$DEFAULT_FILE"
  fi

  # Old flat config becomes meaningless once we've captured a named alias.
  if [ -f "$LEGACY_CONFIG" ]; then
    rm -f "$LEGACY_CONFIG"
  fi

  if MDNEST_URL="$url" MDNEST_TOKEN="$tok" api GET "/namespaces" > /dev/null 2>&1; then
    local resolution_note=""
    [ "$alias_source" = "autodetect" ] && resolution_note=" (SERVER_ALIAS from /api/config)"
    echo "Logged in to @${alias} (${url})${resolution_note}"
    # json_top_string, NOT `grep -o '"version"'`: /api/config carries BOTH a
    # top-level "version" and latestRelease.version, and the nested one is
    # emitted FIRST, so the naive grep returned two lines. It went unnoticed
    # while the value was only used for "${SERVER_VER%%.*}" (still "4"), and
    # became visible the moment the version was printed and compared.
    SERVER_VER=$(fetch_server_config "$url" | json_top_string version) || SERVER_VER=""
    if [ -n "$SERVER_VER" ]; then
      CLI_MAJOR="${MDNEST_CLI_VERSION%%.*}"
      SRV_MAJOR="${SERVER_VER%%.*}"
      if [ "$CLI_MAJOR" != "$SRV_MAJOR" ]; then
        echo "Warning: CLI v${MDNEST_CLI_VERSION} may not be compatible with server v${SERVER_VER}"
      else
        # Same major: not a compatibility problem, but the CLI may still be
        # stale. The old check only fired across a major bump, so a client
        # could sit on a broken point release forever without a word.
        cli_update_notice "$SERVER_VER" "@${alias}"
      fi
    fi
  else
    echo "Warning: could not reach $url — credentials saved, will retry on next command"
  fi
}

cmd_rename() {
  local old="${1#@}" new="${2#@}"
  if [ -z "$old" ] || [ -z "$new" ]; then
    cat >&2 <<'USAGE'
Usage: mdnest rename @<old-alias> @<new-alias>

Rename a server alias. Updates the default pointer if it referred to
the old name. Useful for cleaning up @default installed by older CLI
versions.

Example:
  mdnest rename @default @work
USAGE
    exit 1
  fi
  if [ "$new" = "default" ]; then
    echo "Error: '@default' is not allowed — pick a meaningful name." >&2
    exit 1
  fi
  local old_file new_file
  old_file="$(get_server_file "$old")"
  new_file="$(get_server_file "$new")"
  if [ ! -f "$old_file" ]; then
    echo "No server aliased @${old}" >&2
    exit 1
  fi
  if [ -f "$new_file" ]; then
    echo "Error: @${new} already exists. Choose a different name or logout @${new} first." >&2
    exit 1
  fi
  mv "$old_file" "$new_file"
  if [ -f "$DEFAULT_FILE" ] && [ "$(cat "$DEFAULT_FILE")" = "$old" ]; then
    echo "$new" > "$DEFAULT_FILE"
  fi
  echo "Renamed @${old} → @${new}"
}

cmd_logout() {
  local alias="${1#@}"
  if [ -z "$alias" ]; then
    rm -rf "$SERVERS_DIR" "$DEFAULT_FILE" "$LEGACY_CONFIG"
    echo "Logged out from all servers"
  else
    rm -f "$(get_server_file "$alias")"
    echo "Logged out from @${alias}"
    if [ -f "$DEFAULT_FILE" ] && [ "$(cat "$DEFAULT_FILE")" = "$alias" ]; then
      rm -f "$DEFAULT_FILE"
      local next
      next=$(ls "$SERVERS_DIR" 2>/dev/null | head -1) || next=""
      if [ -n "$next" ]; then
        echo "$next" > "$DEFAULT_FILE"
        echo "Default switched to @${next}"
      fi
    fi
  fi
}

cmd_servers() {
  local verbose=false
  [ "$1" = "-v" ] || [ "$1" = "--verbose" ] && verbose=true

  local def=""
  [ -f "$DEFAULT_FILE" ] && def=$(cat "$DEFAULT_FILE")

  if [ -d "$SERVERS_DIR" ] && [ -n "$(ls "$SERVERS_DIR" 2>/dev/null)" ]; then
    printf "  %-12s  %-35s  %-22s  %s\n" "ALIAS" "URL" "VERSION" "DEFAULT"
    printf "  %-12s  %-35s  %-22s  %s\n" "────────────" "───────────────────────────────────" "──────────────────────" "───────"
    local any_unreachable=0 first_unreachable_url=""
    # Track the newest server we can see, so the listing can tell the user
    # their CLI is behind. Newest rather than first: with several servers
    # registered, the one furthest ahead is the one worth updating towards.
    local newest_ver="" newest_alias=""
    for f in "$SERVERS_DIR"/*; do
      local name=$(basename "$f")
      local url=$(grep '^url=' "$f" 2>/dev/null | cut -d= -f2-)
      local marker=""
      [ "$name" = "$def" ] && marker="*"
      local ver="" commit="" cfg="" curl_rc=0 reachable=0

      # Probe /api/config. --connect-timeout guards against a slow/hanging TCP
      # or TLS handshake (e.g. an unreachable IPv6 address the browser skips via
      # Happy Eyeballs but curl may sit on); --max-time bounds the whole call.
      # Capture curl's EXIT CODE separately so we can tell "couldn't connect"
      # apart from "connected fine but couldn't parse the body" — the old code
      # conflated the two and labelled a perfectly healthy server "unreachable"
      # whenever the JSON parser (python3) was missing.
      # `|| curl_rc=$?` is load-bearing, not defensive style — see api(). An
      # unguarded assignment aborts the script under `set -e` as soon as one
      # server is unreachable, so `mdnest servers` printed the header and
      # nothing else, exited 28, and never reached the labels below. Because
      # the glob is alphabetical, it also hid every server sorting after the
      # dead one.
      cfg=$(curl -s --connect-timeout 5 --max-time 8 "${url}/api/config" 2>/dev/null) || curl_rc=$?
      [ "$curl_rc" = "0" ] && [ -n "$cfg" ] && reachable=1

      if [ "$reachable" = "1" ]; then
        ver=$(printf '%s' "$cfg" | json_top_string version) || ver=""
        commit=$(printf '%s' "$cfg" | json_top_string commit) || commit=""
        if [ -n "$ver" ] && version_gt "$ver" "${newest_ver:-0.0.0}"; then
          newest_ver="$ver"; newest_alias="@${name}"
        fi
        [ -n "$ver" ] || ver="(reachable, version unknown)"
        # Show the build commit next to the version so a stale container is
        # obvious even when the version string hasn't changed.
        [ -n "$commit" ] && [ "$commit" != "dev" ] && ver="$ver ($commit)"
      else
        any_unreachable=1
        [ -n "$first_unreachable_url" ] || first_unreachable_url="$url"
        case "$curl_rc" in
          6)      ver="unreachable (DNS)" ;;
          7)      ver="unreachable (refused)" ;;
          28)     ver="unreachable (timeout)" ;;
          35|60)  ver="unreachable (TLS)" ;;
          *)      ver="unreachable (curl $curl_rc)" ;;
        esac
      fi
      printf "  %-12s  %-35s  %-22s  %s\n" "@${name}" "$url" "$ver" "$marker"

      # Verbose: list namespaces for this server
      if $verbose && [ "$reachable" = "1" ]; then
        local tok=$(grep '^token=' "$f" 2>/dev/null | cut -d= -f2-)
        local ns_json
        ns_json=$(curl -s --connect-timeout 5 --max-time 8 -H "Authorization: Bearer $tok" "${url}/api/namespaces" 2>/dev/null) || ns_json=""
        if [ -n "$ns_json" ] && [ "$ns_json" != "[]" ]; then
          local namespaces
          namespaces=$(printf '%s' "$ns_json" | py -c \
            "import sys,json; [print(ns) for ns in json.load(sys.stdin)]") || namespaces=""
          if [ -z "$namespaces" ]; then
            # Fallback: extract the JSON string array elements without python3.
            namespaces=$(printf '%s' "$ns_json" | grep -o '"[^"]*"' | sed 's/^"//; s/"$//') || namespaces=""
          fi
          if [ -n "$namespaces" ]; then
            printf '%s\n' "$namespaces" | sed "s#^#    → @${name}/#"
          fi
        fi
      fi
    done
    if [ "$any_unreachable" = "1" ]; then
      echo ""
      echo "  A server marked 'unreachable' but working in your browser usually means the"
      echo "  CLI can't reach that URL directly. Check: the stored URL ('mdnest servers -v'),"
      # Name an actually-unreachable server, not whichever one the loop happened
      # to end on — that was often the healthy one, which made the hint useless.
      echo "  VPN/network, or try 'curl -v ${first_unreachable_url}/api/config'."
    fi
    # An `if`, not `[ -n ... ] && ...`: this is the last statement in the
    # branch, so a false test would become cmd_servers's return value and
    # `set -e` would exit the CLI with 1 — the very failure this release is
    # about. Conditions in an `if` are exempt from errexit; a trailing && list
    # is not.
    if [ -n "$newest_ver" ]; then
      cli_update_notice "$newest_ver" "$newest_alias"
    fi
  elif [ -f "$LEGACY_CONFIG" ]; then
    local url=$(grep '^url=' "$LEGACY_CONFIG" 2>/dev/null | cut -d= -f2-)
    printf "  %-12s  %-35s  %s\n" "@default" "$url" "(legacy config)"
  else
    echo "No servers configured. Run: mdnest login @alias <url> <token>"
  fi
}

cmd_whoami() {
  echo "mdnest CLI v${MDNEST_CLI_VERSION}"
  echo ""
  cmd_servers "$@"
}

# Self-update: re-fetch the latest mdnest CLI script from upstream and
# replace this binary in place. Replacing the file at /usr/local/bin/
# mdnest while it's running is safe on Unix — the kernel keeps the open
# inode alive until the current process exits; the next invocation
# picks up the new code. Uses the same source as install-cli.sh.
cmd_update() {
  # Update from the same branch the CLI was installed from — override with
  # MDNEST_BRANCH=develop to track an unreleased build.
  BRANCH="${MDNEST_BRANCH:-main}"
  REPO_URL="https://raw.githubusercontent.com/mahsanamin/mdnest/${BRANCH}"
  REAL_PATH="$(resolve_self "$0")"
  TARGET="$REAL_PATH"

  CURRENT="${MDNEST_CLI_VERSION}"
  LATEST=$(curl -fsSL "$REPO_URL/mdnest" 2>/dev/null | grep '^MDNEST_CLI_VERSION=' | head -1 | cut -d'"' -f2) || LATEST=""
  if [ -z "$LATEST" ]; then
    echo "Error: couldn't reach $REPO_URL — check your network." >&2
    exit 1
  fi

  if [ "$CURRENT" = "$LATEST" ] && [ "$1" != "--force" ]; then
    echo "mdnest CLI is up to date (v${CURRENT})."
    echo "Pass --force to re-download anyway."
    return 0
  fi

  echo "Updating mdnest CLI: v${CURRENT} -> v${LATEST}"
  echo "Target: $TARGET"

  # Download to a temp file first, then install atomically — same reasoning as
  # install-cli.sh: a direct 'curl -o "$TARGET"' can abort mid-write (curl 56)
  # and leave a truncated, unrunnable binary in place. install(1) swaps it in.
  local tmp
  tmp="$(mktemp "${TMPDIR:-/tmp}/mdnest.XXXXXX")" || { echo "Error: couldn't create a temp file." >&2; exit 1; }
  if ! curl -fsSL "$REPO_URL/mdnest" -o "$tmp"; then
    rm -f "$tmp"; echo "Error: download failed — check your network." >&2; exit 1
  fi
  if ! head -1 "$tmp" | grep -q '^#!'; then
    rm -f "$tmp"; echo "Error: downloaded file isn't the mdnest CLI (no shebang); aborting." >&2; exit 1
  fi

  if [ -w "$TARGET" ] || [ -w "$(dirname "$TARGET")" ]; then
    install -m 0755 "$tmp" "$TARGET"
  else
    echo "Target is not writable; using sudo..."
    sudo install -m 0755 "$tmp" "$TARGET"
  fi
  rm -f "$tmp"
  echo "Updated. Run 'mdnest version' to confirm."
}

cmd_list() {
  local as_json="${MDNEST_JSON:-0}" arg=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) as_json=1 ;;
      -*)     echo "Unknown option: $1 — usage: mdnest list [--json] [@alias/namespace/path]" >&2; return 1 ;;
      *)      if [ -z "$arg" ]; then arg="$1"; fi ;;
    esac
    shift
  done

  parse_path "$arg"
  require_server

  # No namespace given: list the namespaces on this server.
  if [ -z "$PARSED_NS" ]; then
    local ns_json
    ns_json=$(api GET "/namespaces") || return 1
    if [ "$as_json" = "1" ]; then printf '%s\n' "$ns_json"; return 0; fi
    format_namespaces "$ns_json"
    return 0
  fi

  # /tree returns the WHOLE namespace, so a deeper path is scoped client-side to
  # just that node (the folder + its children, or the file entry) — before this
  # the deeper path was ignored and the entire namespace came back.
  local tree
  tree=$(api GET "/tree?ns=$(urlencode "$PARSED_NS")") || return 1
  local target="${PARSED_PATH#/}"; target="${target%/}"

  if [ "$as_json" != "1" ]; then
    local header="$PARSED_NS"
    if [ -n "$target" ]; then header="$PARSED_NS/$target"; fi
    format_tree "$tree" "$header" "$target"
    return
  fi

  # ── --json: the raw API payload, for scripts ──
  if [ -z "$target" ]; then
    printf '%s\n' "$tree"
    return 0
  fi

  # python3 first for pretty-printed output; if it's missing OR broken OR
  # finds nothing, fall through to the jq/awk tiers below (which report the
  # not-found error themselves — py() drops python's stderr on purpose).
  local sub
  if sub=$(printf '%s' "$tree" | TARGET="$target" py -c '
import sys, json, os
target = os.environ["TARGET"].strip("/")
root = json.load(sys.stdin)
def find(node):
    if node.get("path", "").strip("/") == target:
        return node
    for c in node.get("children", []):
        r = find(c)
        if r:
            return r
    return None
node = find(root)
if node is None:
    sys.exit(3)
print(json.dumps(node, indent=2))
') && [ -n "$sub" ]; then
    printf '%s\n' "$sub"
    return 0
  fi

  if have jq; then
    sub=$(printf '%s' "$tree" | jq --arg t "$target" \
      'first(.. | objects | select((.path // "" | sub("^/";"") | sub("/$";"")) == $t))' 2>/dev/null) || sub=""
    if [ -z "$sub" ] || [ "$sub" = "null" ]; then
      echo "Error: path not found in namespace: $target" >&2; return 1
    fi
    printf '%s\n' "$sub"; return 0
  fi

  # Pure-awk fallback (no python3/jq): extract the balanced {...} object whose
  # top-level "path" equals target. Output is compact but correctly SCOPED
  # (the actual behaviour); install python3 for pretty-printed output.
  sub=$(printf '%s' "$tree" | awk -v want="$target" '
      { buf = buf $0 }
      END {
        n=length(buf)
        # locate the literal key:value  "path":"want"  (server sends compact JSON)
        needle = "\"path\":\"" want "\""
        pos = index(buf, needle)
        if (pos == 0) { exit 3 }
        # walk buf[1..pos] tracking brace depth + strings; remember the start of
        # each open object on a stack so the innermost open one is the enclosing node
        depth=0; instr=0; esc=0; sp=0
        for (i=1;i<pos;i++) {
          c=substr(buf,i,1)
          if (instr) { if(esc){esc=0} else if(c=="\\"){esc=1} else if(c=="\""){instr=0}; continue }
          if (c=="\"") { instr=1; continue }
          if (c=="{") { sp++; stack[sp]=i; continue }
          if (c=="}") { sp--; continue }
        }
        if (sp < 1) { exit 3 }
        start = stack[sp]
        # from start, scan forward to the matching close brace
        depth=0; instr=0; esc=0
        for (i=start;i<=n;i++) {
          c=substr(buf,i,1)
          if (instr) { if(esc){esc=0} else if(c=="\\"){esc=1} else if(c=="\""){instr=0}; continue }
          if (c=="\"") { instr=1; continue }
          if (c=="{") { depth++; continue }
          if (c=="}") { depth--; if(depth==0){ print substr(buf,start,i-start+1); exit 0 } }
        }
        exit 3
      }') || sub=""
  if [ -z "$sub" ]; then
    echo "Error: path not found in namespace: $target" >&2; return 1
  fi
  printf '%s\n' "$sub"
}

cmd_read() {
  parse_path "$1"
  require_server
  [ -z "$PARSED_NS" ] || [ -z "$PARSED_PATH" ] && { echo "Usage: mdnest read @alias/namespace/path.md" >&2; exit 1; }
  api GET "/note?ns=$(urlencode "$PARSED_NS")&path=$(urlencode "$PARSED_PATH")"
}

# Resolve note content from a positional arg and/or stdin.
#   "-"          → read stdin; error if stdin is a TTY (nothing was piped)
#   "" (omitted) → read stdin if piped; otherwise leave empty (never block a TTY)
#   anything else→ use the literal arg
# Prints content to stdout; on error prints to stderr and returns non-zero.
# Call as: content=$(read_content "$2") || exit 1
read_content() {
  local arg="$1"
  if [ "$arg" = "-" ]; then
    if [ -t 0 ]; then
      echo "Error: '-' given but nothing was piped to stdin" >&2
      return 1
    fi
    cat
    return 0
  fi
  if [ -z "$arg" ] && [ ! -t 0 ]; then
    cat
    return 0
  fi
  printf '%s' "$arg"
}

# Refuse to proceed when no content was actually supplied, instead of issuing
# the API call and reporting a false success on an empty/garbage body.
require_content() {
  if [ -z "$1" ]; then
    echo "Error: no content provided; pass <content> or pipe via stdin with -" >&2
    exit 1
  fi
  return 0
}

cmd_write() {
  parse_path "$1"
  require_server
  [ -z "$PARSED_NS" ] || [ -z "$PARSED_PATH" ] && { echo "Usage: mdnest write @alias/namespace/path.md <content|->" >&2; exit 1; }
  local content; content=$(read_content "$2") || exit 1
  require_content "$content"
  api PUT "/note?ns=$(urlencode "$PARSED_NS")&path=$(urlencode "$PARSED_PATH")" "$content"
}

cmd_create() {
  parse_path "$1"
  require_server
  [ -z "$PARSED_NS" ] || [ -z "$PARSED_PATH" ] && { echo "Usage: mdnest create @alias/namespace/path.md <content|->" >&2; exit 1; }
  local content; content=$(read_content "$2") || exit 1
  require_content "$content"
  api POST "/note?ns=$(urlencode "$PARSED_NS")&path=$(urlencode "$PARSED_PATH")" "$content"
}

cmd_append() {
  parse_path "$1"
  require_server
  [ -z "$PARSED_NS" ] || [ -z "$PARSED_PATH" ] && { echo "Usage: mdnest append @alias/namespace/path.md <content|->" >&2; exit 1; }
  local content; content=$(read_content "$2") || exit 1
  require_content "$content"
  api PATCH "/note?ns=$(urlencode "$PARSED_NS")&path=$(urlencode "$PARSED_PATH")&position=bottom" "$content"
}

cmd_prepend() {
  parse_path "$1"
  require_server
  [ -z "$PARSED_NS" ] || [ -z "$PARSED_PATH" ] && { echo "Usage: mdnest prepend @alias/namespace/path.md <content|->" >&2; exit 1; }
  local content; content=$(read_content "$2") || exit 1
  require_content "$content"
  api PATCH "/note?ns=$(urlencode "$PARSED_NS")&path=$(urlencode "$PARSED_PATH")&position=top" "$content"
}

cmd_delete() {
  parse_path "$1"
  require_server
  [ -z "$PARSED_NS" ] || [ -z "$PARSED_PATH" ] && { echo "Usage: mdnest delete @alias/namespace/path.md" >&2; exit 1; }
  api DELETE "/note?ns=$(urlencode "$PARSED_NS")&path=$(urlencode "$PARSED_PATH")"
}

cmd_move() {
  parse_path "$1"
  require_server
  local to="$2"
  [ -z "$PARSED_NS" ] || [ -z "$PARSED_PATH" ] || [ -z "$to" ] && { echo "Usage: mdnest move @alias/namespace/old-path new-path" >&2; exit 1; }

  # Normalize the destination to a namespace-relative path. Users naturally
  # paste the full "@alias/namespace/path" (same style as the source); passing
  # that through raw made the server treat "@alias/namespace/" as folder names
  # and relocate the file to a bogus "<ns>/@alias/namespace/..." path — the
  # destination then read empty and write/delete 404'd (apparent data loss).
  # Reject cross-namespace moves (move is within one namespace).
  if [[ "$to" == @* ]]; then
    local r="${to#@}"; r="${r#*/}"            # drop "@alias/"
    local to_ns="${r%%/*}" to_path=""
    [[ "$r" == */* ]] && to_path="${r#*/}"
    if [ "$to_ns" != "$PARSED_NS" ]; then
      echo "Error: move stays within one namespace (source: $PARSED_NS, destination: $to_ns)" >&2
      exit 1
    fi
    to="$to_path"
  elif [[ "$to" == "$PARSED_NS"/* ]]; then
    to="${to#"$PARSED_NS"/}"                  # strip a leading "<namespace>/"
  fi
  [ -z "$to" ] && { echo "Error: destination path is empty" >&2; exit 1; }

  api POST "/move?ns=$(urlencode "$PARSED_NS")&from=$(urlencode "$PARSED_PATH")&to=$(urlencode "$to")"
}

cmd_search() {
  parse_path "$1"
  require_server
  local query="$2"
  [ -z "$PARSED_NS" ] || [ -z "$query" ] && { echo "Usage: mdnest search @alias/namespace \"query\"" >&2; exit 1; }
  api GET "/search?ns=$(urlencode "$PARSED_NS")&q=$(urlencode "$query")"
}

# ─── Legacy compat: mdnest note <subcmd> <ns> <path> ───────────────────────

cmd_note_legacy() {
  local subcmd="${1:-help}"
  shift 2>/dev/null || true
  load_default
  require_server
  case "$subcmd" in
    list)     cmd_list "$1" ;;
    # Read the note itself. This used to try cmd_list first and only fall back to
    # /note if that failed — so for a path that exists it printed the tree entry
    # (name/type/path JSON) instead of the note body.
    read)     api GET "/note?ns=$(urlencode "$1")&path=$(urlencode "$2")" ;;
    write)    local ns="$1" p="$2" c; c=$(read_content "$3") || exit 1; require_content "$c"; api PUT "/note?ns=$(urlencode "$ns")&path=$(urlencode "$p")" "$c" ;;
    create)   local ns="$1" p="$2" c; c=$(read_content "$3") || exit 1; require_content "$c"; api POST "/note?ns=$(urlencode "$ns")&path=$(urlencode "$p")" "$c" ;;
    append)   local ns="$1" p="$2" c; c=$(read_content "$3") || exit 1; require_content "$c"; api PATCH "/note?ns=$(urlencode "$ns")&path=$(urlencode "$p")&position=bottom" "$c" ;;
    prepend)  local ns="$1" p="$2" c; c=$(read_content "$3") || exit 1; require_content "$c"; api PATCH "/note?ns=$(urlencode "$ns")&path=$(urlencode "$p")&position=top" "$c" ;;
    delete)   api DELETE "/note?ns=$(urlencode "$1")&path=$(urlencode "$2")" ;;
    move)     api POST "/move?ns=$(urlencode "$1")&from=$(urlencode "$2")&to=$(urlencode "$3")" ;;
    search)   api GET "/search?ns=$(urlencode "$1")&q=$(urlencode "$2")" ;;
    help|--help|-h) cmd_help ;;
    *)        echo "Unknown note command: $subcmd" >&2; exit 1 ;;
  esac
}

# ─── Main dispatch ──────────────────────────────────────────────────────────

cmd_help() {
  cat <<HELP
mdnest CLI v${MDNEST_CLI_VERSION}

  Privately-hosted markdown notes. Read, write, search from any terminal.

QUICK REFERENCE (for AI agents / LLMs)
  Path format:  @alias/namespace/path/to/file.md
  New file:     mdnest create @alias/namespace/path.md "content"
  Edit file:    mdnest write  @alias/namespace/path.md "content"  (file MUST exist)
  Read file:    mdnest read   @alias/namespace/path.md
  Append:       mdnest append @alias/namespace/path.md "text"
  Search:       mdnest search @alias/namespace "query"
  List:         mdnest list   @alias/namespace

  IMPORTANT: "create" = new file. "write" = overwrite EXISTING file (returns 404 if not found).
  Use "mdnest servers -v" to discover available @aliases and namespaces.

USAGE
  mdnest <command> [@alias/namespace/path]

PATH FORMAT
  @alias/namespace/path/to/file.md

  @alias     Your chosen name for a server (set during login, e.g. @work, @home)
  namespace  A workspace on that server (e.g. engineering, notes)
  path       File path within the namespace

  Example: mdnest read @work/engineering/Architecture/system-overview.md

  The @alias is optional if you only have one server configured.
  Single-server: mdnest read engineering/Architecture/system-overview.md

SERVER MANAGEMENT
  login    @alias <url> <token>   Add or overwrite a server alias (you choose the name)
  login    <url> <token>          Use the server's own SERVER_ALIAS (it must be set)
  logout   [@alias]               Remove a server (omit alias to remove all)
  rename   @old @new               Rename a server alias (also updates default)
  servers  [-v]                   List servers (add -v to include namespaces)
  whoami   [-v]                   Show CLI version + servers
  update   [--force]              Self-update to the latest release of this CLI

NOTE OPERATIONS
  create   <path> <content|->     Create a NEW file (fails if already exists; use - for stdin)
  write    <path> <content|->     Overwrite an EXISTING file (fails 404 if not found)
  read     <path>                 Read a note (outputs markdown to stdout)
  append   <path> <content|->     Append text to end (creates file if not found)
  prepend  <path> <content|->     Prepend text to start (creates file if not found)
  delete   <path>                 Delete a note or folder
  move     <path> <new-path>      Move/rename within the same namespace
  list     [@alias/namespace]     List namespaces, or a namespace/folder as a tree
           [--json]               ...as the raw API JSON instead (for scripts)
  search   <ns-path> "query"      Search note contents

OTHER
  version                         Show CLI version
  note <subcommand> ...           Legacy command format (still works)
  docs                            Print full CLI reference

EXAMPLES
  # Setup — pick your own alias name
  mdnest login @work https://work.company.com:3236 mdnest_abc123

  # Setup — let the CLI use the server's own SERVER_ALIAS (must be set on server)
  mdnest login https://work.company.com:3236 mdnest_abc123

  # Rename a legacy @default alias installed by older CLI
  mdnest rename @default @work

  mdnest servers -v                                          # discover aliases + namespaces

  # Create a new file (use "create", NOT "write")
  mdnest create @work/engineering/notes/meeting.md "# Meeting Notes"

  # Create a new file from stdin (pipe content, pass -)
  echo "# Meeting Notes" | mdnest create @work/engineering/notes/meeting.md -

  # Update an existing file (use "write")
  mdnest write @work/engineering/notes/meeting.md "# Updated content"

  # Read
  mdnest read @work/engineering/Architecture/system-overview.md

  # Append (creates the file if it doesn't exist)
  echo "- action item" | mdnest append @work/engineering/log.md -

  # Search
  mdnest search @work/engineering "database schema"

  # List — a tree for humans, --json for scripts
  mdnest list @work/engineering
  mdnest list @work/engineering/Architecture      # scoped to one folder
  mdnest list --json @work/engineering            # raw API JSON

  # Single-server shorthand (no @alias needed)
  mdnest list
  mdnest read engineering/docs/api.md
HELP
}

# Test hook: `MDNEST_LIB=1 source mdnest` loads the functions above WITHOUT
# dispatching a command, so the unit tests can exercise urlencode/urldecode/
# json_top_string directly. When executed normally (MDNEST_LIB unset) this is a
# no-op and dispatch proceeds. When executed (not sourced) the bare `return`
# can't run, so it's guarded to fall through.
if [ -n "${MDNEST_LIB:-}" ]; then return 0 2>/dev/null || exit 0; fi

CMD="${1:-help}"
shift 2>/dev/null || true

# Warn ONCE, up front, if there's no JSON parser — the fallbacks below run inside
# $(...) subshells so a guard flag set there can't reach the parent. Skip for
# commands that neither parse nor encode (help/version/docs/logout).
case "$CMD" in
  help|--help|-h|version|--version|docs|logout) ;;
  *) warn_no_parser ;;
esac

case "$CMD" in
  login)    cmd_login "$@" ;;
  logout)   cmd_logout "$@" ;;
  rename)   cmd_rename "$@" ;;
  servers)  cmd_servers "$@" ;;
  whoami)   cmd_whoami "$@" ;;
  update|upgrade) cmd_update "$@" ;;
  list)     load_default; warn_if_default_alias; cmd_list "$@" ;;
  read)     load_default; warn_if_default_alias; cmd_read "$@" ;;
  write)    load_default; warn_if_default_alias; cmd_write "$@" ;;
  create)   load_default; warn_if_default_alias; cmd_create "$@" ;;
  append)   load_default; warn_if_default_alias; cmd_append "$@" ;;
  prepend)  load_default; warn_if_default_alias; cmd_prepend "$@" ;;
  delete)   load_default; warn_if_default_alias; cmd_delete "$@" ;;
  move)     load_default; warn_if_default_alias; cmd_move "$@" ;;
  search)   load_default; warn_if_default_alias; cmd_search "$@" ;;
  note)     cmd_note_legacy "$@" ;;
  version|--version|-v) echo "mdnest CLI v${MDNEST_CLI_VERSION}" ;;
  docs)
    REAL_PATH="$(resolve_self "$0")"
    DOCS_DIR="$(dirname "$REAL_PATH")/docs"
    [ -f "$DOCS_DIR/cli.md" ] && cat "$DOCS_DIR/cli.md" || echo "Docs not found at $DOCS_DIR/cli.md"
    ;;
  help|--help|-h) cmd_help ;;
  *)
    echo "Unknown command: $CMD"
    echo "Run 'mdnest help' for usage"
    exit 1
    ;;
esac
